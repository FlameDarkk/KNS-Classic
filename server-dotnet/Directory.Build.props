<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1727: LoggerMessage source generators are overkill for this server's log volume.
         CA1305: protocol text is invariant ASCII. CA1707: test names use underscores. -->
    <NoWarn>$(NoWarn);CA1848;CA1727;CA1305;CA1707;CA2007;CA1031;CA1062</NoWarn>
    <!-- One restore serves local builds/tests and the linux-x64 / linux-arm64 deploy publish, so they stop invalidating each
         other's obj/project.assets.json and scripts/dotnet.ps1 can skip restore when nothing changed. -->
    <RuntimeIdentifiers Condition="!$(MSBuildProjectName.EndsWith('Tests'))">linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- scripts\dotnet.ps1 sets KnsObjRoot (env) to a fresh folder per run so no build rewrites a file that a scanner still
         has mapped (CS2012). Restore assets stay in obj\. Plain IDE/CLI builds keep the default obj\ layout. -->
    <IntermediateOutputPath Condition="'$(KnsObjRoot)' != ''">$(KnsObjRoot)\$(MSBuildProjectName)\$(Configuration)\</IntermediateOutputPath>
    <!-- No online vulnerability audit during restore: offline-capable, no shared HTTP cache lock. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
