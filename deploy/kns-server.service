[Unit]
Description=Knights N Squires server (game, Studio, API, World relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kns
Group=kns
EnvironmentFile=/etc/kns/kns.env
WorkingDirectory=/var/lib/kns
ExecStart=/opt/kns/server/KnS.Server
Restart=always
RestartSec=3
# Only the database folder is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kns

[Install]
WantedBy=multi-user.target
