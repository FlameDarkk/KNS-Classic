[Unit]
Description=Knights N Squires Classic server (game, Studio, API, chat)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kns-classic
Group=kns-classic
EnvironmentFile=/etc/kns-classic/kns.env
WorkingDirectory=/var/lib/kns-classic
ExecStart=/opt/kns-classic/server/KnS.Server
Restart=always
RestartSec=3
# Only the database folder is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kns-classic

[Install]
WantedBy=multi-user.target
