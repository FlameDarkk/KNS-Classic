# KnS-Classic server settings. install.sh copies this to /etc/kns/kns.env (Docker: deploy/kns.env next to docker-compose.yml).
# Every setting is optional; the defaults suit one server answering on port 8092.

# Port and address the server listens on. 127.0.0.1 when a reverse proxy (nginx, Caddy) runs on the same machine;
# 0.0.0.0 to answer directly.
KNS_PORT=8092
KNS_BIND=127.0.0.1

# Public URL path everything is served under. "/" when KnS has its own domain or IP; a sub-path such as /kns/
# when another site shares the domain and its proxy forwards that path unchanged. The game is at <base>,
# Admin Studio at <base>studio, and the API at <base>api/.
KNS_PUBLIC_BASE=/

# The packaged browser build (game page, Admin Studio, icons). install.sh and the Docker image set this.
KNS_WEB_ROOT=/opt/kns/web

# Player database (SQLite, created on first start). Back this file up.
KNS_DB=/var/lib/kns/kns.sqlite

# Admin key for Admin Studio and /admin/* (X-Admin-Key header): 64 hex characters.
# install.sh generates one when this is empty. Keep it secret.
KNS_ADMIN_KEY=

# Hosted servers keep no per-request logs (they grow without limit).
KNS_QUIET=1
KNS_LOG_DIR=/var/lib/kns/logs

# The Linux server needs no ICU libraries in this mode.
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
# Smaller memory use on small VMs (workstation GC, no diagnostics pipe).
DOTNET_gcServer=0
DOTNET_EnableDiagnostics=0
